# ==== Database (Supabase Postgres connection string) ====
# Supabase dashboard -> Settings -> Database -> Connection string -> Direct/URI
# If your DB password has special characters (@, #, etc.), percent-encode them.
DATABASE_URL=postgresql://postgres:your-db-password@db.xxxxxxxx.supabase.co:5432/postgres

# ==== Supabase project (used only for reference / future storage integration) ====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# ==== Auth ====
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ==== Server ====
PORT=5000
WS_PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ==== Uploads ====
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15
